<Window x:Class="CodexAccountSwitcher.Views.ConversationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史对话恢复"
        Icon="../Assets/CodexAccountSwitcher.ico"
        Width="700"
        Height="560"
        MinWidth="700"
        MinHeight="560"
        MaxWidth="700"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Grid Margin="20,0,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="历史对话恢复" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="只读查看本机 Codex 记录，不修改会话文件或数据库" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="36"
                        Click="CloseButton_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="20,10,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Height="34"
                         Padding="10,6"
                         BorderBrush="{DynamicResource BorderBrush}"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="按标题、内容、目录或会话 ID 搜索"
                         AutomationProperties.Name="搜索历史对话" />
                <Button Grid.Column="1"
                        Width="72"
                        Height="34"
                        Margin="8,0,0,0"
                        Click="RefreshButton_Click"
                        Content="刷新"
                        Style="{StaticResource ActionButtonStyle}" />
            </Grid>

            <Grid Grid.Row="2">
                <ListBox x:Name="HistoryItems"
                         Margin="14,0,14,8"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10"
                                    Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock MaxWidth="470"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}" />
                                            <TextBlock Margin="8,1,0,0"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Text="{Binding ArchiveText}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding Preview}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Preview}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding WorkingDirectory}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding WorkingDirectory}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock HorizontalAlignment="Right"
                                                   Margin="0,0,0,8"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding UpdatedText}" />
                                        <Button Width="96"
                                                Height="32"
                                                Click="OpenButton_Click"
                                                Content="在 Codex 打开"
                                                Tag="{Binding}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar Width="160" Height="5" IsIndeterminate="True" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="正在读取历史对话…" />
                </StackPanel>

                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="没有找到匹配的历史对话"
                           Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="3"
                    Padding="20,10"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="等待读取" />
            </Border>
        </Grid>
    </Border>
</Window>
