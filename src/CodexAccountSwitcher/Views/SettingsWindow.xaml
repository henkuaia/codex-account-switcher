<Window x:Class="CodexAccountSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="../Assets/CodexAccountSwitcher.ico"
        Width="480"
        Height="380"
        MinWidth="480"
        MinHeight="380"
        MaxWidth="480"
        MaxHeight="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Margin="20,0,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="设置" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="启动与外观" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="36"
                        Click="CancelButton_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,8,20,0">
                <Border Padding="16,14"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheckBox"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Checked="AutoStartCheckBox_Changed"
                                  Unchecked="AutoStartCheckBox_Changed">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock FontWeight="SemiBold" Text="开机自启动" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="登录 Windows 后自动运行账号切换器" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="StartMinimizedCheckBox"
                                  Margin="26,14,0,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Content="启动后隐藏到托盘" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="16,14"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="外观主题" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="可跟随 Windows 应用模式" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeComboBox"
                                  Grid.Column="1"
                                  Height="32"
                                  Padding="8,0"
                                  VerticalContentAlignment="Center"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText"
                           Margin="2,12,2,0"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="20,10,20,14">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="76"
                            Click="CancelButton_Click"
                            Content="取消"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button x:Name="SaveButton"
                            Width="76"
                            Margin="8,0,0,0"
                            Click="SaveButton_Click"
                            Content="保存"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
