<Window x:Class="CodexAccountSwitcher.Views.TokenUsageStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Token 用量统计"
        Icon="../Assets/CodexAccountSwitcher.ico"
        Width="760"
        Height="590"
        MinWidth="760"
        MinHeight="590"
        MaxWidth="760"
        MaxHeight="590"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Grid Margin="20,0,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Token 用量统计" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="全部账号 · 按本机 Codex 会话记录统计" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="36"
                        Click="CloseButton_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="20,10,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="54"
                        Click="TodayButton_Click"
                        Content="今日"
                        Style="{StaticResource ActionButtonStyle}" />
                <Button Grid.Column="1"
                        Width="72"
                        Margin="6,0,0,0"
                        Click="LastSevenDaysButton_Click"
                        Content="最近7天"
                        Style="{StaticResource ActionButtonStyle}" />
                <Button Grid.Column="2"
                        Width="54"
                        Margin="6,0,0,0"
                        Click="ThisMonthButton_Click"
                        Content="本月"
                        Style="{StaticResource ActionButtonStyle}" />
                <DatePicker x:Name="StartDatePicker"
                            Grid.Column="4"
                            Height="32"
                            VerticalContentAlignment="Center"
                            SelectedDateFormat="Short" />
                <TextBlock Grid.Column="5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="至" />
                <DatePicker x:Name="EndDatePicker"
                            Grid.Column="6"
                            Height="32"
                            VerticalContentAlignment="Center"
                            SelectedDateFormat="Short" />
                <Button Grid.Column="7"
                        Width="54"
                        Margin="6,0,0,0"
                        Click="QueryButton_Click"
                        Content="查询"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Column="9"
                        Width="64"
                        Click="RefreshButton_Click"
                        Content="刷新"
                        Style="{StaticResource ActionButtonStyle}" />
            </Grid>

            <Grid Grid.Row="2" Margin="20,0,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12,10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="输入（百万 Token）" />
                        <TextBlock x:Name="InputTokenText" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="12,10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="缓存输入（百万 Token）" />
                        <TextBlock x:Name="CachedInputTokenText" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="12,10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="输出（百万 Token）" />
                        <TextBlock x:Name="OutputTokenText" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Padding="12,10" Background="{DynamicResource PrimaryBrush}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock Foreground="White" Opacity="0.82" Text="总量（百万 Token）" />
                        <TextBlock x:Name="TotalTokenText" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Foreground="White" Text="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="20,0,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RangeText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="每日明细" />
                    <TextBlock Grid.Column="1"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="缓存输入已包含在输入中，不重复计入总量" />
                </Grid>
                <ListView x:Name="DailyItems"
                          Grid.Row="1"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="120" Header="日期" DisplayMemberBinding="{Binding DateText}" />
                            <GridViewColumn Width="145" Header="输入（百万）" DisplayMemberBinding="{Binding InputMillions, StringFormat=N3}" />
                            <GridViewColumn Width="145" Header="缓存输入（百万）" DisplayMemberBinding="{Binding CachedInputMillions, StringFormat=N3}" />
                            <GridViewColumn Width="145" Header="输出（百万）" DisplayMemberBinding="{Binding OutputMillions, StringFormat=N3}" />
                            <GridViewColumn Width="145" Header="总量（百万）" DisplayMemberBinding="{Binding TotalMillions, StringFormat=N3}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel x:Name="LoadingPanel"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar Width="160" Height="5" IsIndeterminate="True" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="正在扫描本机用量…" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="4"
                    Padding="20,10"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="等待读取" />
            </Border>
        </Grid>
    </Border>
</Window>
